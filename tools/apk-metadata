#!/bin/sh
set -eu
task_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
mkdir -p "$task_root/.tools/bin"
GOWORK=off go -C "$task_root/go" build -o "$task_root/.tools/bin/apk-metadata" ./cmd/apk-metadata
# Preserve the caller's directory so relative APK/tool paths remain meaningful.
exec "$task_root/.tools/bin/apk-metadata" "$@"
